# Copy to .env for local runs: cp .env.example .env
# .env is git-ignored. In Portainer, put these into the stack's
# "Environment variables" section instead -- never into this repository.

# ---------------------------------------------------------------------------
# Spotify (https://developer.spotify.com/dashboard -> Create app)
# Redirect URI to register: http://127.0.0.1:8479/callback
# (8479 dodges the usual home-server occupants of 8080. For another port,
#  set AUTH_PORT and register the matching redirect URI.)
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Produced by:
#   docker compose -f docker-compose.auth.yml run --rm --service-ports auth spotify
SPOTIFY_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Deezer -- usually nothing to fill in here.
#
# Public playlists are readable without any credentials, which is the
# supported path. A token is only needed for private playlists, and Deezer
# has closed new app registration ("We're not accepting new application
# creation at this time"), so there is no way to obtain one from scratch.
# Make the playlist public instead. See the README, Schritt 3.
#
# The three values below only apply if you already have an older Deezer app.
# ---------------------------------------------------------------------------
DEEZER_APP_ID=
DEEZER_APP_SECRET=
# Produced by:
#   docker compose -f docker-compose.auth.yml run --rm --service-ports auth deezer
DEEZER_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# What to mirror. Deezer is always the master.
# One entry per line, or several separated by ';' (handy in the Portainer UI).
#
#   908622995                                  -> Spotify playlist named like the Deezer one
#   908622995 -> "Rock Mirror"                 -> Spotify playlist with that name
#   908622995 -> 37i9dQZF1DXcBWIGoYBM5M        -> that exact Spotify playlist
#   908622995 -> https://open.spotify.com/playlist/37i9dQZF1DXcBWIGoYBM5M
# ---------------------------------------------------------------------------
PLAYLISTS=908622995 -> "Rock Mirror"; 123456789 -> "Chill Mirror"

# ---------------------------------------------------------------------------
# How the sync is triggered
#   schedule  built-in loop, every SYNC_INTERVAL_MINUTES (default)
#   server    idle until something POSTs to /sync -- for n8n, see README
#   once      one pass, then exit (for your own cron)
# ---------------------------------------------------------------------------
MODE=schedule
SYNC_INTERVAL_MINUTES=60

# Server mode only. Required there: a POST to /sync rewrites playlists.
# Generate with: openssl rand -hex 32
API_TOKEN=
HTTP_PORT=8477
# Log what would change without touching Spotify. Recommended for the first run.
DRY_RUN=true
LOG_LEVEL=INFO
TZ=Europe/Berlin

CREATE_MISSING_PLAYLISTS=true
SPOTIFY_PLAYLISTS_PUBLIC=false

# ---------------------------------------------------------------------------
# Matching tuning
#   MATCH_THRESHOLD      raise it for stricter matching, lower it for more hits
#   MAX_UNMATCHED_RATIO  abort a playlist if more than this share fails to match
# ---------------------------------------------------------------------------
MATCH_THRESHOLD=0.72
DURATION_TOLERANCE_SECONDS=8
SEARCH_LIMIT=8
ALLOW_EMPTY_MIRROR=false
ALLOW_PARTIAL_SOURCE=false
MAX_UNMATCHED_RATIO=1.0
