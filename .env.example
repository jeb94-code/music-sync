# Copy to .env for local runs: cp .env.example .env
# .env is git-ignored. In Portainer, put these into the stack's
# "Environment variables" section instead -- never into this repository.

# ---------------------------------------------------------------------------
# Spotify (https://developer.spotify.com/dashboard -> Create app)
# Redirect URI to register: http://127.0.0.1:8080/callback
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Produced by: docker compose run --rm --service-ports auth spotify
SPOTIFY_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Deezer (https://developers.deezer.com/myapps -> Create application)
# Redirect URL to register: http://localhost:8080/callback
# App ID and secret are only needed by the auth helper, not by the sync loop.
# ---------------------------------------------------------------------------
DEEZER_APP_ID=
DEEZER_APP_SECRET=
# Produced by: docker compose run --rm --service-ports auth deezer
# Only needed for private playlists; public ones are readable without it.
DEEZER_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# What to mirror. Deezer is always the master.
# One entry per line, or several separated by ';' (handy in the Portainer UI).
#
#   908622995                                  -> Spotify playlist named like the Deezer one
#   908622995 -> "Rock Mirror"                 -> Spotify playlist with that name
#   908622995 -> 37i9dQZF1DXcBWIGoYBM5M        -> that exact Spotify playlist
#   908622995 -> https://open.spotify.com/playlist/37i9dQZF1DXcBWIGoYBM5M
# ---------------------------------------------------------------------------
PLAYLISTS=908622995 -> "Rock Mirror"; 123456789 -> "Chill Mirror"

# ---------------------------------------------------------------------------
# Schedule and behaviour
# ---------------------------------------------------------------------------
SYNC_INTERVAL_MINUTES=60
RUN_ONCE=false
# Log what would change without touching Spotify. Recommended for the first run.
DRY_RUN=true
LOG_LEVEL=INFO
TZ=Europe/Berlin

CREATE_MISSING_PLAYLISTS=true
SPOTIFY_PLAYLISTS_PUBLIC=false

# ---------------------------------------------------------------------------
# Matching tuning
#   MATCH_THRESHOLD      raise it for stricter matching, lower it for more hits
#   MAX_UNMATCHED_RATIO  abort a playlist if more than this share fails to match
# ---------------------------------------------------------------------------
MATCH_THRESHOLD=0.72
DURATION_TOLERANCE_SECONDS=8
SEARCH_LIMIT=8
ALLOW_EMPTY_MIRROR=false
ALLOW_PARTIAL_SOURCE=false
MAX_UNMATCHED_RATIO=1.0
